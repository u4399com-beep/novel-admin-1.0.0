# ============================================================
# Novel Management System - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ─── Database ────────────────────────────────────────────
# SQLite (default) or PostgreSQL connection string
# SQLite:  file:./db/app.db
# Postgres: postgresql://novel_admin:password@localhost:5432/novel_admin
DATABASE_URL="file:./db/app.db"

# ─── App Config ──────────────────────────────────────────
# Scraper service base URL (internal service-to-service)
SCRAPER_SERVICE_URL="http://localhost:3099"
# Public-facing app name (used in SEO, titles)
# This is intentionally NEXT_PUBLIC_ so it's available in browser JS bundle
NEXT_PUBLIC_APP_NAME="小说管理系统"
# Public-facing app URL (used for canonical URLs, sitemap)
# This is intentionally NEXT_PUBLIC_ so it's available in browser JS bundle
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Authentication (REQUIRED) ───────────────────────────
# Cryptographic secret for NextAuth JWT signing.
# Must be >= 32 characters in production. Generate with: openssl rand -base64 32
# SECURITY: Never commit actual secrets to git. Only set in deployment environment.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Admin login credentials (no default — must be explicitly set)
# SECURITY: These are server-only (no NEXT_PUBLIC_ prefix) — never exposed to browser
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# ─── Service-to-Service Auth (REQUIRED) ──────────────────
# Independent token for scraper-service <-> Next.js communication.
# Must be different from NEXTAUTH_SECRET. Min 16+ chars in production.
# Generate with: openssl rand -base64 32
# SECURITY: Never commit actual tokens to git
SCRAPER_SERVICE_TOKEN=""

# ─── Database Provider ───────────────────────────────────
# "sqlite" for local development, "postgresql" for Docker production
# Only affects scraper-service queue. Prisma provider is set in schema.prisma.
DB_PROVIDER="sqlite"

# ─── Optional: External Scraping Services ────────────────
# Firecrawl (alternative scraping engine)
# FIRECRAWL_API_KEY=""
# FIRECRAWL_API_URL="http://localhost:3002"
# AgentQL (AI-powered structured extraction)
# AGENTQL_API_KEY=""
# AGENTQL_API_URL="https://api.agentql.com"
# Cloud browser provider for JS-heavy sites ("browserless" or "steel")
# CLOUD_BROWSER_PROVIDER="browserless"
# BROWSERLESS_API_KEY=""
# BROWSERLESS_API_URL=""
# STEEL_API_KEY=""
# STEEL_API_URL=""

# ─── Optional: Translate Service ─────────────────────────
# URL for the Python-based translation microservice
# TRANSLATE_SERVICE_URL="http://localhost:5000"

# ─── Optional: Log Stream Service ────────────────────────
# URL for the log-stream microservice (real-time task logs)
# LOG_STREAM_URL="http://localhost:3100"

# ─── Optional: Scraper Service Config ────────────────────
# Main app URL for scraper->app callbacks (defaults to http://localhost:3000)
# MAIN_APP_URL="http://localhost:3000"
# Scraper service listen port (defaults to 3099)
# PORT="3099"
# CORS allowed origin for scraper service (defaults to http://localhost:3000)
# ALLOWED_ORIGIN="http://localhost:3000"
# Disable adaptive rate optimization (set to 'false' to disable)
# ADAPTIVE_RATE_MODE="true"
# SSRF: allow private/internal network targets (NEVER in production)
# SCRAPER_SSRF_ALLOW_PRIVATE="false"
# Proxy list (comma-separated proxy URLs)
# PROXY_LIST=""
# Proxy verification URL (defaults to https://httpbin.org/ip)
# SCRAPER_PROXY_VERIFY_URL="https://httpbin.org/ip"
# Tor proxy support
# SCRAPER_TOR_ENABLED="false"
# SCRAPER_TOR_PROXY="socks5://127.0.0.1:9050"
# Circuit breaker thresholds
# SCRAPER_CB_FAILURE_THRESHOLD="5"
# SCRAPER_CB_RECOVERY_TIMEOUT_MS="30000"
# SCRAPER_CB_HALF_OPEN_MAX="1"
# Canvas noise intensity for fingerprint randomization
# SCRAPER_CANVAS_NOISE_INTENSITY=""
# DoH (DNS-over-HTTPS) providers (comma-separated URLs)
# SCRAPER_DOH_PROVIDERS=""
# Scrapling service URL (Python-based alternative scraper)
# SCRAPLING_SERVICE_URL="http://127.0.0.1:3031"
# DokoBot service URL
# DOKOBOT_SERVICE_URL="http://127.0.0.1:3032"

# ─── Optional: Debug / Development ───────────────────────
# Enable debug logging in scraper-service
# DEBUG="false"
# Log level for scraper-service: debug, info, warn, error
# LOG_LEVEL="info"
# Bypass authentication for development (NEVER use in production)
# BYPASS_AUTH="false"
# Skip auth check in admin layout (development only)
# SKIP_AUTH="false"
# Timezone for daily statistics queries
# TZ="Asia/Shanghai"
