# ============================================================
# Novel Management System - Caddy Reverse Proxy Config
#
# Place this file at ./Caddyfile and uncomment the
# gateway service in docker-compose.multiservice.yml
#
# Features:
#   - Automatic HTTPS via Let's Encrypt
#   - HTTP→HTTPS redirect
#   - WebSocket support for log-stream
#   - Compression
#   - Security headers
# ============================================================

# Replace with your domain
your-domain.com {
    # Main app
    reverse_proxy app:3000

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        X-XSS-Protection "1; mode=block"
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    # Compression
    encode gzip zstd

    # Logs
    log {
        output file /data/access.log
        format json
    }
}

# HTTP→HTTPS redirect (uncomment if using HTTPS)
# http://your-domain.com {
#     redir https://your-domain.com{uri} permanent
# }
