{
  "name": "鬼吹灯小说网 (guichuideng.info)",
  "description": "鬼吹灯小说网全站采集。GBK编码，使用Obscura隐身引擎绕过基础反爬。单页书单，无列表分页。OG标签提供高质量结构化数据作为主要提取源。",
  "enabled": true,
  "listUrl": "https://www.guichuideng.info/book/",
  "listSelector": {
    "type": "css",
    "value": ".item .image a[href]"
  },
  "listPagination": null,
  "bookTitleSelector": {
    "type": "css",
    "value": "meta[property='og:novel:book_name']",
    "extract": "content"
  },
  "bookAuthorSelector": {
    "type": "css",
    "value": "meta[property='og:novel:author']",
    "extract": "content"
  },
  "bookCategorySelector": {
    "type": "css",
    "value": "meta[property='og:novel:category']",
    "extract": "content"
  },
  "bookKeywordsSelector": {
    "type": "css",
    "value": "meta[name='Keywords']",
    "extract": "content"
  },
  "bookDescriptionSelector": {
    "type": "css",
    "value": ".xdesc"
  },
  "bookCoverSelector": {
    "type": "css",
    "value": "meta[property='og:image']",
    "extract": "content"
  },
  "bookStatusSelector": {
    "type": "css",
    "value": "meta[property='og:novel:status']",
    "extract": "content"
  },
  "chapterListUrl": "{bookUrl}",
  "chapterListSelector": {
    "type": "css",
    "value": "ul#section-list, .section-list"
  },
  "chapterTitleSelector": {
    "type": "css",
    "value": "ul#section-list a[href], .section-list a[href]"
  },
  "chapterLinkSelector": {
    "type": "css",
    "value": "ul#section-list a[href], .section-list a[href]"
  },
  "chapterPagination": null,
  "contentTitleSelector": {
    "type": "css",
    "value": "h1.title"
  },
  "contentSelector": {
    "type": "css",
    "value": "#content"
  },
  "contentPagination": {
    "type": "next",
    "selector": "a:contains(\"下一章\")",
    "maxPage": 1
  },
  "antiCrawlConfig": {
    "useJsRender": true,
    "uaRotation": true,
    "delay": [
      2000,
      4000
    ],
    "humanBehavior": true,
    "retries": 2,
    "referer": "https://www.guichuideng.info/",
    "stealthMode": "basic",
    "rotateUA": true,
    "delayJitter": 0.3
  },
  "cleanConfig": {
    "removeAds": true,
    "cleanHtml": true,
