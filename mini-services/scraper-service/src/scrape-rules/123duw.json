{
  "name": "123读网 (123duw.com)",
  "description": "123读网全站采集。GBK编码，playwright引擎（PC端内容有屏蔽），使用移动UA绕过。优先使用og:novel标签提取书名/作者等，回退到.bnovelslist2结构。支持16个分类，高延迟配合playwright策略。",
  "enabled": true,
  "listUrl": "https://www.123duw.com/sort/{page}/",
  "listSelector": {
    "type": "css",
    "value": ".novelslist li a[href*=\"/book/\"]"
  },
  "listPagination": {
    "type": "page",
    "selector": ".pagelistbox a[href*=\"_\"]",
    "maxPage": 200
  },
  "bookTitleSelector": {
    "type": "css",
    "value": "meta[property='og:novel:book_name'], #info h1",
    "extract": "content"
  },
  "bookAuthorSelector": {
    "type": "css",
    "value": "meta[property='og:novel:author'], #info p:first-of-type",
    "extract": "content"
  },
  "bookCategorySelector": {
    "type": "css",
    "value": "meta[property='og:novel:category'], .bnovelslist2 .category",
    "extract": "content"
  },
  "bookKeywordsSelector": {
    "type": "css",
    "value": "meta[name='Keywords']",
    "extract": "content"
  },
  "bookDescriptionSelector": {
    "type": "css",
    "value": "meta[property='og:description'], #intro",
    "extract": "content"
  },
  "bookCoverSelector": {
    "type": "css",
    "value": "meta[property='og:image'], #fmimg img",
    "extract": "content"
  },
  "bookStatusSelector": {
    "type": "css",
    "value": "meta[property='og:novel:status']",
    "extract": "content"
  },
  "chapterListUrl": "{bookUrl}",
  "chapterListSelector": {
    "type": "css",
    "value": "#list dl dd a"
  },
  "chapterTitleSelector": {
    "type": "css",
    "value": "#list dl dd a"
  },
  "chapterLinkSelector": {
    "type": "css",
    "value": "#list dl dd a"
  },
  "chapterPagination": null,
  "contentTitleSelector": {
    "type": "css",
    "value": "h1.title, .bookname h1"
  },
  "contentSelector": {
    "type": "css",
    "value": "#content, .content"
  },
  "contentPagination": {
    "type": "next",
    "selector": "a:contains(下一页), a:contains(下一章)",
    "maxPage": 1
  },
