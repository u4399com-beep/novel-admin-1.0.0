{
  "name": "和书屋 (hetushu.com)",
  "description": "和书屋全站采集。UTF-8编码，cheerio引擎。结构：.book-info h1书名、.book-info .author作者、.chapter-list a章节列表、.content内容区。支持16个分类，标准延迟策略。",
  "enabled": true,

  "listUrl": "https://www.hetushu.com/book/{catId}/",
  "listSelector": { "type": "css", "value": ".book-list .book-item a" },
  "listPagination": { "type": "page", "selector": ".pagination a, .page a", "maxPage": 200 },

  "bookTitleSelector": { "type": "css", "value": ".book-info h1" },
  "bookAuthorSelector": { "type": "css", "value": ".book-info .author" },
  "bookCategorySelector": { "type": "css", "value": ".book-info .tag a:first-child" },
  "bookKeywordsSelector": null,
  "bookDescriptionSelector": { "type": "css", "value": ".book-info .intro" },
  "bookCoverSelector": { "type": "css", "value": ".book-info .cover img", "extract": "src" },
  "bookStatusSelector": { "type": "css", "value": ".book-info .status" },

  "chapterListUrl": "{bookUrl}",
  "chapterListSelector": { "type": "css", "value": ".chapter-list a" },
  "chapterTitleSelector": { "type": "css", "value": ".chapter-list a" },
  "chapterLinkSelector": { "type": "css", "value": ".chapter-list a" },
  "chapterPagination": null,

  "contentTitleSelector": { "type": "css", "value": "h1.title, .content-title" },
  "contentSelector": { "type": "css", "value": ".content" },
  "contentPagination": { "type": "next", "selector": "a:contains(下一页), a.next", "maxPage": 1 },

  "antiCrawlConfig": {
    "useJsRender": false,
    "uaRotation": true,
    "delay": [1500, 5000],
    "humanBehavior": false,
    "retries": 3,
    "referer": "https://www.hetushu.com/"
  },

  "cleanConfig": {
    "removeAds": true,
    "cleanHtml": true,
    "removePatterns": [
      ".ad", ".ads", ".advertisement",
      ".chapter-nav", ".footer", ".header", ".topbar",
      ".recommend", ".related",
      "#ad", "[id^=\"div-gpt-ad\"]",
      "ins.adsbygoogle",
      ".chapter-list", ".book-info",
      ".pageheadermenu", ".leftmenu", ".modbg",
      ".main", ".container", ".mybox",
      ".weekl_yrank", ".droplist",
      ".bookimg", ".bookimg2",
      ".ratediv", ".rateblock",
      ".pc-footer", ".m-footer"
    ],
    "adPatterns": [
      "hetushu", "hetushu.com", "和书屋",
      "请记住本书", "手机用户请浏览",
      "本章未完", "最快更新",
      "本章最新章节", "请访问",
      "如果您喜欢", "分享到",
      "扫码关注", "微信公众号",
      "关注公众号", "关注我们",
      "TXT下载", "全本下载",
      "返回目录", "章节列表",
      "推荐本书", "打赏",
      "本章完", "本章结束",
      "完结感言", "在线听书",
      "热门推荐", "内容有问题",
      "无弹窗小说", "无弹窗阅读",
      "加入书签", "邮件反馈",
      "最新章节", "正在手打中",
      "网友上传", "文学网"
    ]
  },

  "scrapeMode": "full",
  "engine": "cheerio",
  "storageMode": "database",
  "filePath": null,
  "coverSavePath": "/app/public/covers/hetushu/",
  "threadCount": 1,
  "minDelay": 1500,
  "maxDelay": 5000,
  "enableShuffle": false,
  "dedupMode": "both",

  "meta": {
    "siteType": "novel",
    "domain": "www.hetushu.com",
    "encoding": "utf-8",
    "engineType": "cheerio",
    "stealthEnabled": false,
    "categories": {
      "xuanhuan": "玄幻小说",
      "xiuzhen": "武侠仙侠",
      "dushi": "都市小说",
      "lishi": "历史小说",
      "kehuan": "科幻小说",
      "youxi": "游戏小说",
      "xuanyi": "悬疑小说",
      "yanqing": "言情小说",
      "danmei": "耽美小说",
      "chuanyue": "穿越小说",
      "qingchun": "校园小说",
      "tongren": "同人小说",
      "guanchang": "官场小说",
      "lingyi": "灵异小说",
      "junshi": "军事小说",
      "qingxiaoshuo": "轻小说"
    },
    "urlPatterns": {
      "listPage": "/book/{catId}/",
      "bookDetail": "/book/{id}.html",
      "chapterIndex": "/book/{id}.html",
      "chapterContent": "/read/{bookId}/{chapterId}.html"
    },
    "statusMap": {
