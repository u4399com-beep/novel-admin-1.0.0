    "selector": "a[href*=\"index_\"]",
    "maxPage": 500
  },
  "bookTitleSelector": {
    "type": "regex",
    "value": "(?<=<title>)\\s*?([^\\s<][^<]*?)\\s*?(?=(?:txt下载|TXT下载))"
