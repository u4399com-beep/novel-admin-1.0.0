{
  "name": "8看啦 (8kana.com)",
  "description": "8看啦全站采集。UTF-8编码，cheerio引擎。页面结构：.book-name书名、.book-img img封面、.chapter-list li a章节列表、#content/.content正文内容。自定义布局，非标准biquge结构，需针对性选择器配置。",
  "enabled": true,

  "listUrl": "https://www.8kana.com/sort/{page}/",
  "listSelector": { "type": "css", "value": "a[href*='/book/']" },
  "listPagination": { "type": "page", "selector": ".pagination a, .pagelist a", "maxPage": 200 },

  "bookTitleSelector": { "type": "css", "value": ".book-name" },
  "bookAuthorSelector": { "type": "css", "value": ".book-info .author, .book-detail .author" },
  "bookCategorySelector": { "type": "css", "value": ".book-info .category, .book-detail .category" },
  "bookKeywordsSelector": null,
  "bookDescriptionSelector": { "type": "css", "value": ".book-info .intro, .book-intro, .book-detail .description" },
  "bookCoverSelector": { "type": "css", "value": ".book-img img", "extract": "src" },
  "bookStatusSelector": { "type": "css", "value": ".book-info .status, .book-detail .status" },

  "chapterListUrl": "{bookUrl}",
  "chapterListSelector": { "type": "css", "value": ".chapter-list li a" },
  "chapterTitleSelector": { "type": "css", "value": ".chapter-list li a" },
  "chapterLinkSelector": { "type": "css", "value": ".chapter-list li a" },
  "chapterPagination": null,

  "contentTitleSelector": { "type": "css", "value": "h1.title, .chapter-title, .content-title" },
  "contentSelector": { "type": "css", "value": "#content, .content" },
  "contentPagination": { "type": "next", "selector": "a:contains(下一页), a:contains(下一章)", "maxPage": 1 },

  "antiCrawlConfig": {
    "useJsRender": false,
    "uaRotation": true,
    "delay": [1500, 5000],
    "humanBehavior": false,
    "retries": 3,
    "referer": "https://www.8kana.com/"
  },

  "cleanConfig": {
    "removeAds": true,
    "cleanHtml": true,
    "removePatterns": [
      ".ad", ".ads", ".advertisement",
      ".chapter-nav", ".footer", ".header", ".topbar",
      ".recommend", ".related",
      "#ad", "[id^=\"div-gpt-ad\"]",
      "ins.adsbygoogle",
      ".bookname",
      ".pageheadermenu", ".leftmenu", ".modbg",
      ".main", ".container", ".mybox",
      ".weekl_yrank", ".droplist",
      ".bookimg", ".bookimg2",
      ".ratediv", ".rateblock",
      ".pc-footer", ".m-footer"
    ],
    "adPatterns": [
      "8kana", "8kana.com", "8看啦",
      "请记住本书", "手机用户请浏览",
      "本章未完", "最快更新",
      "本章最新章节", "请访问",
      "如果您喜欢", "分享到",
      "扫码关注", "微信公众号",
      "关注公众号", "关注我们",
      "TXT下载", "全本下载",
      "返回目录", "章节列表",
      "推荐本书", "打赏",
      "本章完", "本章结束",
      "完结感言", "在线听书",
      "热门推荐", "内容有问题",
      "无弹窗小说", "无弹窗阅读",
      "加入书签", "邮件反馈",
      "最新章节", "正在手打中",
      "网友上传", "文学网"
    ]
  },

  "scrapeMode": "full",
  "engine": "cheerio",
  "storageMode": "database",
  "filePath": null,
  "coverSavePath": "/app/public/covers/8kana/",
  "threadCount": 1,
  "minDelay": 3000,
  "maxDelay": 6000,
  "enableShuffle": false,
  "dedupMode": "both",

  "meta": {
    "siteType": "novel",
    "domain": "www.8kana.com",
    "encoding": "utf-8",
    "engineType": "cheerio",
    "stealthEnabled": false,
    "categories": {
      "xuanhuan": "玄幻小说",
      "xiuzhen": "武侠仙侠",
