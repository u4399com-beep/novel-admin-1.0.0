{
  "name": "格格党小说 (gegedangbook.com)",
  "description": "格格党小说网全站采集。UTF-8编码，qula模板站。书页/txt/{id}.html、完整章节目录/fm/{id}/、章节内容/chapter/{bookId}/{chapterId}.html。静态HTML可用cheerio引擎。支持8个分类，搜索接口POST /search/ searchkey参数。Cloudflare防护需注意。",
  "enabled": true,
  "listUrl": "https://www.gegedangbook.com/sort/{catId}/{page}.html",
  "listSelector": {
    "type": "css",
    "value": ".section-box ul.section-list li a, .item dl dt a"
  },
  "listPagination": {
    "type": "page",
    "selector": ".pagelist a, .listpage a, .page a",
    "maxPage": 200
  },
  "bookTitleSelector": {
    "type": "css",
    "value": ".info .top h1"
  },
  "bookAuthorSelector": {
    "type": "css",
    "value": ".info .top .fix p a[href*='/author/']"
  },
  "bookCategorySelector": {
    "type": "css",
    "value": ".info .top .fix p.xs-show:first-of-type"
  },
  "bookKeywordsSelector": null,
  "bookDescriptionSelector": {
    "type": "css",
    "value": ".desc, .m-desc"
  },
  "bookCoverSelector": {
    "type": "css",
    "value": ".imgbox img",
    "extract": "src"
  },
  "bookStatusSelector": {
    "type": "css",
    "value": ".info .top .fix p.xs-show:nth-of-type(2)"
  },
  "chapterListUrl": "https://www.gegedangbook.com/fm/{bookId}/",
  "chapterListSelector": {
    "type": "css",
    "value": ".section-box ul.section-list li a"
  },
  "chapterTitleSelector": {
    "type": "css",
    "value": "a"
  },
  "chapterLinkSelector": {
    "type": "css",
    "value": "a",
    "extract": "href"
  },
  "chapterPagination": null,
  "contentTitleSelector": {
    "type": "css",
    "value": ".reader h1, .booktitle h1"
  },
  "contentSelector": {
    "type": "css",
    "value": "#content, .content"
  },
  "contentPagination": {
    "type": "next",
    "selector": "a:contains(下一页), a:contains(下一章)",
    "maxPage": 1
  },
  "antiCrawlConfig": {
    "useJsRender": false,
    "uaRotation": true,
    "delay": [
      1500,
      3000
    ],
    "humanBehavior": false,
    "retries": 3,
    "referer": "https://www.gegedangbook.com/",
    "engineFallback": true,
    "engineFallbackChain": [
      "cheerio",
      "playwright"
    ],
    "stealthMode": "moderate",
    "rotateUA": true,
    "delayJitter": 0.4,
    "respect429": true
  },
  "cleanConfig": {
    "removeAds": true,
    "cleanHtml": true,
