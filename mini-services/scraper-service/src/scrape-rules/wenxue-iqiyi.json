{
  "name": "爱奇艺小说 (wenxue.iqiyi.com)",
  "description": "爱奇艺小说全站采集。UTF-8编码，大厂反爬（iQiyi/爱奇艺），使用Playwright隐身引擎+JS渲染+人类行为模拟。书库URL格式: lib-{base}_{sub}_0-51-0-{page}.html，详情页含部分章节，完整目录在catalog-{bookId}-{page}.html。阅读页内容在.reader-article中，下一章链接a#nextChpater。详情页书名在.book-details-tit h1，作者在.writerName，简介在.book-details-briefing，封面在.bookBigCover img，状态在.stacksBook-tag，分类在面包屑.breadCrumbNav第二项。列表页书籍链接在li.stacksBook a[href*='detail-']，分页在.mod-page a。【VIP章节行为】VIP/付费章节在网页端仅显示约20%内容，随后出现'.chapter-pay'付费墙提示'此章节为付费章节，请到手机上继续观看'。页面显示完整字数（如'字数：2,076'）但HTML中仅含约500字。目录页无VIP标记（JS渲染）。完整内容需付费/VIP订阅，切换移动端UA无法绕过。详情页pingback脚本含bookId。",
  "enabled": true,

  "listUrl": "https://wenxue.iqiyi.com/book/lib-18l2g48o37_0_0-51-0-1.html",
  "listSelector": { "type": "css", "value": "li.stacksBook a[href*='detail-']" },
  "listPagination": {
    "type": "next",
    "selector": ".mod-page a[href*='lib-']",
    "maxPage": 50,
    "urlPattern": "https://wenxue.iqiyi.com/book/lib-18l2g48o37_0_0-51-0-{page}.html"
  },

  "bookTitleSelector": { "type": "css", "value": ".book-details-tit h1" },
  "bookAuthorSelector": { "type": "css", "value": ".book-details-about .writerName" },
  "bookCategorySelector": { "type": "css", "value": ".breadCrumbNav a:nth-child(2)" },
  "bookKeywordsSelector": { "type": "css", "value": "meta[name='keywords']", "extract": "content" },
  "bookDescriptionSelector": { "type": "css", "value": ".book-details-briefing" },
  "bookCoverSelector": { "type": "css", "value": ".bookBigCover img", "extract": "src" },
  "bookStatusSelector": { "type": "css", "value": ".stacksBook-tag" },

  "chapterListUrl": "https://wenxue.iqiyi.com/book/catalog-{bookId}-1.html",
  "chapterListSelector": { "type": "css", "value": "dl.catalog-list" },
  "chapterTitleSelector": { "type": "css", "value": "dl.catalog-list .catalog-chapter a[href*='reader-']" },
  "chapterLinkSelector": { "type": "css", "value": "dl.catalog-list .catalog-chapter a[href*='reader-']" },
  "chapterPagination": {
    "type": "next",
    "selector": "a[href*='catalog-'][href$='.html']",
    "maxPage": 50,
    "urlPattern": "https://wenxue.iqiyi.com/book/catalog-{bookId}-{page}.html"
  },

  "contentTitleSelector": { "type": "css", "value": "strong.reader-chapter-tit" },
  "contentSelector": { "type": "css", "value": "div.reader-article" },
  "contentPagination": { "type": "next", "selector": "a#nextChpater[href*='reader-']", "maxPage": 1 },

  "antiCrawlConfig": {
    "useJsRender": true,
    "uaRotation": true,
    "delay": [3000, 6000],
    "humanBehavior": true,
    "retries": 3,
    "referer": "https://wenxue.iqiyi.com/"
  },

  "cleanConfig": {
    "removeAds": true,
    "cleanHtml": true,
    "removePatterns": [
      ".reader-header", ".readerScrollBar", ".reader-progress",
      ".reader-nextChapter", ".reader-btn-add", ".reader-btn-alreadyAdd",
      ".breadCrumbNav", ".mod-pop-wrapper", ".mod-popBg", ".mod-pop",
      ".reader-bookInfo", "#funcbar", "#newbieGuide", "#qrcDialog",
      ".phoneContinue", ".book-QRcode", ".getBtn-box",
      "script", "noscript", "style",
      ".mod-wrapper > .mod-con > .top",
      ".mod-wrapper > .mod-con > a",
      "[id^='qrcDialog']", "#goToPhone",
      "#addToShlef", "#alreadAddedToShlef",
      ".reader-main > .reader-bookInfo",
      ".chapter-briefing", ".chapter-read",
      ".list-tit-wrapper", ".list-txt",
      ".book-details-btnBox", ".btn-readfree",
      ".catalog-time", ".j_forbidden_card",
      ".chapter-pay", ".chapter-pay-phoneContinue",
      ".hotcmd-box", ".hotcmd-wp",
      ".sidebar", ".footer", ".header", ".topbar",
      "#userdata_el"
