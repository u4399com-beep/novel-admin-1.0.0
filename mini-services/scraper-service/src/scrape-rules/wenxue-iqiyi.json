  "vipDetection": {
    "enabled": true,
    "indicators": {
      "cssSelectors": [".chapter-pay", ".chapter-pay-phoneContinue", ".j_forbidden_card"],
      "textPatterns": ["此章节为付费章节", "请到手机上继续观看", "开通VIP", "VIP专享", "付费章节"],
      "contentTruncationCheck": {
        "enabled": true,
        "wordCountSelector": "meta[name='description']",
        "minTruncationRatio": 0.3
      }
    },
    "action": "mark_as_vip_and_truncate",
    "mobileUaStrategy": {
      "enabled": true,
      "description": "VIP chapters on wenxue.iqiyi.com only show ~20% on any browser. Full content requires payment/VIP subscription. Mobile UA does NOT bypass this paywall.",
      "userAgents": [
        "Mozilla/5.0 (Linux; Android 14; SM-S928B) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/127.0.0.0 Mobile Safari/537.36",
        "Mozilla/5.0 (iPhone; CPU iPhone OS 17_6 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.6 Mobile/15E148 Safari/604.1"
      ]
    }
  },

  "scrapeMode": "full",
  "engine": "playwright",
  "storageMode": "database",
  "filePath": null,
  "coverSavePath": "/app/public/covers/wenxue-iqiyi/",
