{
  "name": "速读谷 (shudugu.org)",
  "description": "速读谷全站采集。UTF-8编码，使用cheerio引擎。分类页/{category}/，分页/{category}/{page}.html。书籍详情页含完整章节列表(#list.dir.clear ul li a)，内容页在.con，支持内容分页(.prenext a下一页)。",
  "enabled": true,
  "listUrl": "https://www.shudugu.org/{catId}/",
  "listSelector": {
    "type": "css",
    "value": ".container .item > a[href^=\"/\"]"
  },
  "listPagination": {
    "type": "page",
    "selector": ".page ul a[href$=.html]",
    "maxPage": 200
  },
  "bookTitleSelector": {
    "type": "css",
    "value": ".item .itemtxt h1 a"
  },
  "bookAuthorSelector": {
    "type": "css",
    "value": ".item .itemtxt p a[href*=zuozhe]"
  },
  "bookCategorySelector": {
    "type": "css",
    "value": ".item .itemtxt p span:nth-child(2)"
  },
  "bookKeywordsSelector": null,
  "bookDescriptionSelector": {
    "type": "css",
    "value": ".des.bb"
  },
  "bookCoverSelector": {
    "type": "css",
    "value": ".item > a > img",
    "extract": "src"
  },
  "bookStatusSelector": {
    "type": "css",
    "value": ".item .itemtxt p span:first-child"
  },
  "chapterListUrl": "{bookUrl}",
  "chapterListSelector": {
    "type": "css",
    "value": "#list.dir.clear ul li a"
  },
  "chapterTitleSelector": {
    "type": "css",
    "value": "#list.dir.clear ul li a"
  },
  "chapterLinkSelector": {
    "type": "css",
    "value": "#list.dir.clear ul li a"
  },
  "chapterPagination": null,
  "contentTitleSelector": {
    "type": "css",
    "value": ".submenu h1"
  },
  "contentSelector": {
    "type": "css",
    "value": ".con"
  },
  "contentPagination": {
    "type": "next",
    "selector": ".prenext a",
    "maxPage": 10
  },
  "antiCrawlConfig": {
    "stealthMode": "basic",
    "rotateUA": true,
    "delayJitter": 0.3
  },
  "cleanConfig": {
    "removeAds": true,
    "cleanHtml": true,
    "removePatterns": [
      ".ad",
      ".ads",
      ".advertisement",
