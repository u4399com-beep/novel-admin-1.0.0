{
  "name": "69书吧 (69shuba.com)",
  "description": "69书吧全站采集。GBK编码，Cloudflare Turnstile保护。首页/分类/书籍详情/目录页可用cheerio直采，章节内容页(/txt/)受Cloudflare JS Challenge保护需playwright+stealth模式。URL结构：分类页/novels/class/{catId}.htm，书籍详情/book/{id}.htm，完整目录/book/{id}/，章节内容/txt/{bookId}/{chapterId}。AJAX分页：/ajax_novels/class/{catId}/{page}.htm。已知DOM：详情页div.booknav2 h1 a书名、div.booknav2 p作者/分类/状态、div.bookimg2 img封面、div.navtxt p简介；目录页div.catalog#catalog ul li章节列表；内容页div.txtnav章节正文。高延迟配合Cloudflare挑战等待。",
  "enabled": true,

  "listUrl": "https://www.69shuba.com/novels/class/{catId}.htm",
  "listSelector": { "type": "css", "value": "#article_list_content li" },
  "listPagination": { "type": "ajax", "selector": "#article_list_content", "urlTemplate": "https://www.69shuba.com/ajax_novels/class/{catId}/{page}.htm", "maxPage": 200 },

  "bookTitleSelector": { "type": "css", "value": ".booknav2 h1 a" },
  "bookAuthorSelector": { "type": "css", "value": ".booknav2 p:nth-child(2) a" },
  "bookCategorySelector": { "type": "css", "value": ".booknav2 p:nth-child(3) a" },
  "bookKeywordsSelector": null,
  "bookDescriptionSelector": { "type": "css", "value": ".navtxt p:first-child" },
  "bookCoverSelector": { "type": "css", "value": ".bookimg2 img", "extract": "src" },
  "bookStatusSelector": { "type": "css", "value": ".booknav2 p:nth-child(4)" },

  "chapterListUrl": null,
  "chapterListSelector": { "type": "css", "value": ".catalog ul li" },
  "chapterTitleSelector": { "type": "css", "value": "a" },
  "chapterLinkSelector": { "type": "css", "value": "a", "extract": "href" },
  "chapterPagination": null,

  "contentTitleSelector": { "type": "css", "value": ".txtnav h1" },
  "contentSelector": { "type": "css", "value": ".txtnav" },
  "contentPagination": null,

  "antiCrawlConfig": {
    "useJsRender": true,
    "uaRotation": true,
    "delay": [3000, 6000],
    "humanBehavior": true,
    "retries": 5,
    "referer": "https://www.69shuba.com/",
    "cloudflareBypass": {
      "enabled": true,
      "waitForChallenge": true,
      "challengeTimeout": 20000,
      "verifyCleared": true
    },
    "stealthOptions": {
      "blockResources": true,
      "emulateDevice": "desktop"
    },
    "engineFallback": true,
    "engineFallbackChain": ["cheerio", "playwright"]
  },

  "cleanConfig": {
    "removeAds": true,
    "cleanHtml": true,
    "removePatterns": [
      ".ad", ".ads", ".advertisement",
      ".yueduad1", ".contentadv", ".bottom-ad", ".bottom-ad2",
      "#txtright", ".txtinfo", ".page1",
      ".tools", ".pageheadermenu", ".pagefootermenu",
      ".leftmenu", ".modbg", ".modelbg",
      ".tuijian", ".yuedutuijian",
      ".baocuo", "#baocuo",
      ".setbox", ".top_Scroll",
      ".headbox", ".foot",
      "#infoad", "#ad-3-2-container",
      "ins.adsbygoogle", "ins.pubadx-slot",
      "script", "noscript",
      ".bread", ".hide720"
    ],
    "adPatterns": [
