{
  "name": "101看書 (101kks.com)",
  "description": "101看書繁體中文小說站全站採集。UTF-8編碼，OG標籤提供結構化數據。分類頁面含分頁，書籍詳情頁OG標籤豐富，章節目錄獨立頁面，章節內容頁使用標準div結構。",
  "enabled": true,
  "listUrl": "https://www.101kks.com/sort/{page}/",
  "listSelector": {
    "type": "css",
    "value": ".newnovels li a[href*='/book/']"
  },
  "listPagination": {
    "type": "page",
    "selector": ".pagelistbox a[href*=\"_\"]",
    "maxPage": 50
  },
  "bookTitleSelector": {
    "type": "css",
    "value": "meta[property='og:novel:book_name']",
    "extract": "content"
  },
  "bookAuthorSelector": {
    "type": "css",
    "value": "meta[property='og:novel:author']",
    "extract": "content"
  },
  "bookCategorySelector": {
    "type": "css",
    "value": "meta[property='og:novel:category']",
    "extract": "content"
  },
  "bookKeywordsSelector": {
    "type": "css",
    "value": "meta[name='Keywords']",
    "extract": "content"
  },
  "bookDescriptionSelector": {
    "type": "css",
    "value": "meta[property='og:description']",
    "extract": "content"
  },
  "bookCoverSelector": {
    "type": "css",
    "value": "meta[property='og:image']",
    "extract": "content"
  },
  "bookStatusSelector": {
    "type": "css",
    "value": "meta[property='og:novel:status']",
    "extract": "content"
  },
  "chapterListUrl": "{bookUrl}/index.html",
  "chapterListSelector": {
    "type": "css",
    "value": ".listmain"
  },
  "chapterTitleSelector": {
    "type": "css",
    "value": ".listmain a[href*='/txt/']"
  },
  "chapterLinkSelector": {
    "type": "css",
    "value": ".listmain a[href*='/txt/']"
  },
  "chapterPagination": null,
  "contentTitleSelector": {
    "type": "css",
    "value": "h1.title, .bookname h1"
  },
  "contentSelector": {
    "type": "css",
    "value": "#content, .content, .readcontent"
  },
  "contentPagination": {
    "type": "next",
    "selector": "a:contains(下一頁), a:contains(下一章)",
    "maxPage": 1
  },
