{
  "name": "老标 (laobiao.cc)",
  "description": "老标全站采集。UTF-8编码，cheerio引擎。页面结构：.book-info h1书名、.chapter-list a章节列表、.content正文内容。自定义简洁布局，非标准biquge结构，需针对性选择器配置。",
  "enabled": true,
  "listUrl": "https://www.laobiao.cc/sort/{page}/",
  "listSelector": {
    "type": "css",
    "value": "a[href*='/book/'], a[href*='/novel/']"
  },
  "listPagination": {
    "type": "page",
    "selector": ".pagination a, .pagelist a",
    "maxPage": 200
  },
  "bookTitleSelector": {
    "type": "css",
    "value": ".book-info h1"
  },
  "bookAuthorSelector": {
    "type": "css",
    "value": ".book-info .author"
  },
  "bookCategorySelector": {
    "type": "css",
    "value": ".book-info .category, .book-info .tag"
  },
  "bookKeywordsSelector": null,
  "bookDescriptionSelector": {
    "type": "css",
    "value": ".book-info .intro, .book-intro"
  },
  "bookCoverSelector": {
    "type": "css",
    "value": ".book-info img, .book-cover img",
    "extract": "src"
  },
  "bookStatusSelector": {
    "type": "css",
    "value": ".book-info .status"
  },
  "chapterListUrl": "{bookUrl}",
  "chapterListSelector": {
    "type": "css",
    "value": ".chapter-list a"
  },
  "chapterTitleSelector": {
    "type": "css",
    "value": ".chapter-list a"
  },
  "chapterLinkSelector": {
    "type": "css",
    "value": ".chapter-list a"
  },
  "chapterPagination": null,
  "contentTitleSelector": {
    "type": "css",
    "value": "h1.title, .chapter-title"
  },
  "contentSelector": {
    "type": "css",
    "value": ".content"
  },
  "contentPagination": {
    "type": "next",
    "selector": "a:contains(下一页), a:contains(下一章)",
    "maxPage": 1
  },
  "antiCrawlConfig": {
    "stealthMode": "moderate",
    "rotateUA": true,
    "delayJitter": 0.4,
    "respect429": true
  },
