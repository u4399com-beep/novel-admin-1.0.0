    "type": "page",
    "selector": ".page-list a, .pagelist a",
    "maxPage": 200
  },
  "bookTitleSelector": {
    "type": "css",
    "value": "#info h1, .book-title h1, h1"
  },
  "bookAuthorSelector": {
    "type": "css",
    "value": "#info p a, .book-author a, .author a"
  },
  "bookCategorySelector": {
    "type": "css",
    "value": ".con_top a:nth-child(2), .breadcrumb a:nth-child(2)"
  },
  "bookKeywordsSelector": null,
  "bookDescriptionSelector": {
    "type": "css",
    "value": "#intro, .book-intro, .intro"
  },
  "bookCoverSelector": {
    "type": "css",
    "value": "#fmimg img, .book-cover img, .cover img",
    "extract": "src"
  },
  "bookStatusSelector": {
    "type": "css",
    "value": "#info p:last-of-type, .book-status, .status"
  },
  "chapterListUrl": "{bookUrl}",
