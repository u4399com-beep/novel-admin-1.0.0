{
  "name": "礼吧好小说 (libahao2.com)",
  "description": "礼吧好小说全站采集。UTF-8编码，疑似biquge衍生站。URL结构/book/{bookId}_{chapterId}.html为章节内容页。1Panel WAF地区拦截，需playwright+stealth模式绕过。分类路径包括/xuanhuan/、/qita/等。站点有地区限制，需代理或海外IP访问。",
  "enabled": false,
  "listUrl": "https://www.libahao2.com/{catId}/{page}.html",
  "listSelector": {
    "type": "css",
    "value": ".novelslist li a, #newscontent li a, .book-list li a"
  },
