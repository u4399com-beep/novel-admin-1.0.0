# ============================================================
# 小说管理系统 - Docker 生产环境配置模板
# ============================================================
#
# 使用方法：
#   1. 复制本文件为 .env：  cp .env.docker .env
#   2. （推荐）运行 quick-docker.sh 自动生成密钥并启动
#   3. （手动）把所有 change-this 替换为你自己的值
#
# ⚠️  重要：所有 change-this 值必须替换，否则启动会失败！
#     docker-entrypoint.sh 会检测到模板占位值并拒绝启动。
#
# 一键部署命令:
#   chmod +x quick-docker.sh && ./quick-docker.sh
#
# 远程一行安装（推荐）:
#   bash <(curl -fsSL https://raw.githubusercontent.com/u4399com-beep/novel-admin-1.0.0/main/quick-docker.sh)
#
# 国内一行安装（GitHub 加速）:
#   bash <(curl -fsSL https://ghfast.top/https://raw.githubusercontent.com/u4399com-beep/novel-admin-1.0.0/main/quick-docker.sh)
#
# ============================================================

# ─── PostgreSQL 数据库 ─────────────────────────────────────
# 数据库用户名
POSTGRES_USER=novel
# 数据库密码（⚠️ 必须修改！至少16位）
POSTGRES_PASSWORD=change-this-to-a-strong-db-password-16chars
# 数据库名称
POSTGRES_DB=novel_admin
# 数据库端口（内部通信用，一般不需要改）
DB_PORT=5432

# ─── 应用配置 ──────────────────────────────────────────────
# 对外暴露的端口号（如被占用可改为 8080 等）
APP_PORT=3000
# 应用名称（显示在浏览器标签页和页面标题）
APP_NAME=小说管理系统
# 应用访问地址（⚠️ 如果有域名，改为 https://yourdomain.com）
# 本地部署填服务器IP: http://你的IP:3000
APP_URL=http://localhost:3000
# 时区
TZ=Asia/Shanghai

# ─── 数据目录 ──────────────────────────────────────────────
# 宿主机备份目录（会挂载到容器内 /backups）
BACKUP_DIR=./backups

# ─── 认证密钥（⚠️ 必须修改！）─────────────────────────────
# NextAuth 加密密钥（至少32位随机字符）
# 生成方法: openssl rand -hex 32
NEXTAUTH_SECRET=change-this-to-a-random-secret-min-32-chars
# NextAuth 回调地址（通常与 APP_URL 相同）
NEXTAUTH_URL=http://localhost:3000

# ─── 管理员账号 ────────────────────────────────────────────
# 登录用户名
ADMIN_USERNAME=admin
# 登录密码（⚠️ 必须修改！至少8位）
# 生成方法: openssl rand -base64 12
ADMIN_PASSWORD=change-this-to-a-strong-password

# ─── 服务间通信密钥（⚠️ 必须修改！）───────────────────────
# Scraper 服务与 Next.js 之间的认证令牌（至少32位，必须与 NEXTAUTH_SECRET 不同）
# 生成方法: openssl rand -hex 32
SCRAPER_SERVICE_TOKEN=change-this-to-another-random-string-min-32

# ─── 可选：外部采集服务 ──────────────────────────────────
# 如果不需要可以不填，留空即可
#FIRECRAWL_API_KEY=
#FIRECRAWL_API_URL=
#AGENTQL_API_KEY=
#AGENTQL_API_URL=
#CLOUD_BROWSER_PROVIDER=browserless
#BROWSERLESS_API_KEY=
#BROWSERLESS_API_URL=
#STEEL_API_KEY=
#STEEL_API_URL=

# ============================================================
# 硬件自适应资源限制
# ============================================================
# 以下参数根据服务器内存自动选择配置档位：
#
#   档位     内存       PG内存   PG共享   App内存  App共享内存
#   ────────────────────────────────────────────────────────
#   tiny    <1.5GB     128M     32MB     512M     64m
#   small   1.5-3GB    192M     64MB     640M     128m
#   normal  3GB+       256M     128MB    1024M    256m
#
# quick-docker.sh 会根据检测到的内存自动选择档位。
# 手动部署时，请根据你的服务器配置选择下方对应的档位，
# 注释掉其他档位的值。
#
# 当前配置: normal 档（≥3GB 内存服务器）
# ============================================================

# ─── 构建时设置 ────────────────────────────────────────────
# Next.js 构建的 V8 堆内存上限（MB）
NODE_MAX_OLD_SPACE_SIZE=1024
# Bun 安装依赖时的 GC 阈值
BUN_GC_THRESHOLD=100mb

# ─── PostgreSQL 容器资源限制 ──────────────────────────────
# 容器最大内存
PG_MEMORY_LIMIT=256M
# 容器内存预留（保证最低可用）
PG_MEMORY_RESERVATION=64M
# PG 共享缓冲区（越大越快，吃内存）
PG_SHARED_BUFFERS=128MB
# PG 排序/哈希操作的内存上限
PG_WORK_MEM=8MB
# PG 维护操作（VACUUM, CREATE INDEX）的内存上限
PG_MAINTENANCE_WORK_MEM=64MB
# PG 预期可用的操作系统缓存
PG_EFFECTIVE_CACHE_SIZE=256MB
# PG 最大连接数
PG_MAX_CONNECTIONS=30
# PG WAL 日志最大/最小尺寸
PG_MAX_WAL_SIZE=64MB
PG_MIN_WAL_SIZE=8MB
# PG CPU 限制
PG_CPU_LIMIT=1.0

# ─── 应用容器资源限制 ──────────────────────────────────────
# 容器最大内存
APP_MEMORY_LIMIT=1024M
# 容器内存预留
APP_MEMORY_RESERVATION=256M
# 共享内存大小（/dev/shm，Node.js 需要）
APP_SHM_SIZE=256m
# CPU 限制
APP_CPU_LIMIT=1.0

# ============================================================
# 档位配置参考（取消注释对应档位即可切换）
# ============================================================

# ─── tiny 档（1核1G / 1核1.5G / 2核1G 服务器）───
# NODE_MAX_OLD_SPACE_SIZE=384
# BUN_GC_THRESHOLD=50mb
# PG_MEMORY_LIMIT=128M
# PG_MEMORY_RESERVATION=32M
# PG_SHARED_BUFFERS=32MB
# PG_WORK_MEM=2MB
# PG_MAINTENANCE_WORK_MEM=16MB
# PG_EFFECTIVE_CACHE_SIZE=64MB
# PG_MAX_CONNECTIONS=10
# PG_MAX_WAL_SIZE=16MB
# PG_MIN_WAL_SIZE=2MB
# PG_CPU_LIMIT=0.3
# APP_MEMORY_LIMIT=512M
# APP_MEMORY_RESERVATION=128M
# APP_SHM_SIZE=64m
# APP_CPU_LIMIT=0.7

# ─── small 档（2核2G / 1核2G 服务器）──────
# NODE_MAX_OLD_SPACE_SIZE=512
# BUN_GC_THRESHOLD=100mb
# PG_MEMORY_LIMIT=192M
# PG_MEMORY_RESERVATION=64M
# PG_SHARED_BUFFERS=64MB
# PG_WORK_MEM=4MB
# PG_MAINTENANCE_WORK_MEM=32MB
# PG_EFFECTIVE_CACHE_SIZE=128MB
# PG_MAX_CONNECTIONS=20
# PG_MAX_WAL_SIZE=32MB
# PG_MIN_WAL_SIZE=4MB
# PG_CPU_LIMIT=0.5
# APP_MEMORY_LIMIT=640M
# APP_MEMORY_RESERVATION=256M
# APP_SHM_SIZE=128m
# APP_CPU_LIMIT=0.8

# ─── normal 档（2核4G / 4核4G+ 服务器）───
# （当前已激活，见上方默认值）
