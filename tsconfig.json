{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true
  },
  "include": ["scripts/**/*.mjs", "scripts/**/*.ts", "tests/**/*"],
  "exclude": [
    "node_modules",
    "mini-services",
    "skills",
    "download",
    "upload",
    "scripts/archive",
    "tool-results"
  ]
}
