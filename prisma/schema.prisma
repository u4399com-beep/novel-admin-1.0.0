// schema.prisma —— DB 表结构权威参考（Task 27 起 Go 单栈，本文件仍为结构定义的单一事实源）。
// 说明：
//   - 运行时 backend-go 用 modernc.org/sqlite 纯 Go 驱动直连同一个 SQLite 库（db/custom.db），
//     不经过 Prisma Client——本 schema 供人工核对结构与 Go 侧手写 SQL 的字段对照；
//   - `bun run db:push`（dev 链路建库/同步）按本文件建表，表/列名与 Go 侧 SQL 必须保持一致；
//   - 新增列需同时改 Go 侧（storex/api_* 的读写语句）与种子（seed/seed.json 如涉及）。
// 当前模型：Category / Novel / Chapter / SiteSetting / SiteSite / PseoKeyword / ScrapeRule / ScrapeTask（无过期模型）。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== 小说站核心模型 ====================

model Category {
  id     Int    @id @default(autoincrement())
  name   String @unique
  sort   Int    @default(0)
  novels Novel[]
}

model Novel {
  id          Int      @id @default(autoincrement())
  title       String
  author      String
  description String   @default("")
  cover       String   @default("g1") // 渐变封面 token: g1-g12
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  status      String   @default("serial") // serial=连载中 finished=已完本
  isFeatured  Boolean  @default(false)
  isHot       Boolean  @default(false)
  wordCount   Int      @default(0)
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())
  chapters    Chapter[]

  // 同名同作者视为同一本书：防止并发采集任务重复入库同一新书（worker 层有 P2002 回读兜底）
  @@unique([title, author])
  // 分类页/首页按 categoryId 过滤列表：避免随书量增长退化为全表扫
  @@index([categoryId])
  // 「最近更新」按 updatedAt 排序、「点击排行」按 clicks 排序：列表高频排序走索引
  @@index([updatedAt])
  @@index([clicks])
}

model Chapter {
  id        Int      @id @default(autoincrement())
  novelId   Int
  novel     Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  idx       Int
  title     String
  // Task 32-b 垂直分表：正文主存储迁移至 ChapterContent（chapterId 主键，Go 侧运行时建表）。
  // 本列保留作存量兼容回落（COALESCE 读路径），新写恒为空串。TOC/列表/管理查询不再拖正文 blob
  content   String   @default("")
  wordCount Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([novelId, idx])
  @@index([novelId])
}

// Chapter 正文垂直分表（Task 32-b，Go 侧运行时幂等建表管理，db:push 不感知；结构对照文档）
// 语义：chapterId = Chapter.id（终生不变——idx 会因重排序/并发顺延改变，不可作正文键）；
// 级联链 Novel→Chapter→ChapterContent 双跳 ON DELETE CASCADE，章/书删除正文自动清理。
// 读路径统一 loadChapterContent 三级回落：ChapterContent → Chapter.content 存量 → TXT 分章文件
// （storageMode=txt 的书正文落盘 /home/z/my-project/download/novels/{novelId}/{idx}_{title}.txt）
model ChapterContent {
  chapterId Int    @id
  content   String @default("")
}

// 站点设置（单例行 id=1，默认站点档案；站群命中 SiteSite 后按站点覆盖渲染）
model SiteSetting {
  id           Int    @id @default(1)
  siteName     String @default("青阅文学")
  activeTheme  String @default("aijjxs")
  notice       String @default("本站所有小说仅供学习演示使用，请支持正版。")
  seoConfig    String @default("{}") // JSON: SEO TDK 模板配置
  footerConfig String @default("{}") // JSON: 页面底部（页脚）配置 {text,extra,links}
  homeConfig   String @default("{}") // JSON: 首页自定义图文区块配置 {blocks:[{id,title,source,count}]}
}

// 站群站点档案（Task 30-a 一库多站：按 host 精确匹配分站点渲染，未命中走 SiteSetting 默认站点。
// 该表由 backend-go db.go ensureSiteSiteTable 幂等建表运行时管理，此处为结构对照文档）
model SiteSite {
  id           Int     @id @default(autoincrement())
  host         String  @unique // 纯域名（小写，不带协议/路径/端口），如 novel.example.com
  siteName     String
  activeTheme  String  @default("aijjxs")
  notice       String  @default("")
  seoConfig    String  @default("{}") // JSON: 站点级 SEO TDK 模板（键集同 SiteSetting.seoConfig 白名单）
  footerConfig String  @default("{}") // JSON: 站点级页脚 {text,extra,links}
  homeConfig   String  @default("{}") // JSON: 站点级首页区块 {blocks:[…]}
  enabled      Boolean @default(true) // 停用后该 Host 立即回落默认站点
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())
}

// PSEO 关键词（来自搜索引擎下拉词）
model PseoKeyword {
  id        Int      @id @default(autoincrement())
  keyword   String   @unique
  source    String   @default("manual") // manual | baidu | bing | duckduckgo | sogou | 360
  status    String   @default("pending") // pending | generated | failed
  pageData  String?  // JSON: 生成的聚合页数据（命中书籍、生成的TDK等）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
}

// 采集规则（针对目标站点的选择器配置）
model ScrapeRule {
  id           Int          @id @default(autoincrement())
  name         String       @unique
  siteUrl      String
  enabled      Boolean      @default(true)
  charset      String       @default("utf-8")
  proxy        String       @default("") // 站点级出口代理（空=直连；http(s)/socks5(h)://host:port，反爬 IP 信誉突破）
  insecureTLS  Boolean      @default(false) // 跳过目标站 TLS 证书校验（自签/裸 IP 站点，如 https://38.34.172.127）
  listRule     String       @default("{}") // JSON: 列表页选择器
  bookRule     String       @default("{}") // JSON: 书籍页选择器（可含 chapterListApi=JSON 目录接口配置）
  chapterRule  String       @default("{}") // JSON: 正文页选择器
  notes        String       @default("")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt @default(now())
  tasks        ScrapeTask[]
}

// 采集任务（单本采集 / 范围采集）
model ScrapeTask {
  id        Int         @id @default(autoincrement())
  ruleId    Int?
  rule      ScrapeRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  mode      String      @default("single") // single=单本(书页URL) | list=范围(列表页URL批量)
  // Task 32-b TXT 文件存储模式：db=仅入库（ChapterContent 分表）| txt=仅分章 TXT 文件
  //（download/novels/{novelId}/ 一章一文件，读路径三级回落兜底）| both=双写
  storageMode String    @default("db")
  targetUrl String
  pages     Int         @default(1) // list 模式抓取列表页数 1-999（用户指令取消 20 页限制）
  status    String      @default("pending") // pending|running|success|partial|failed|canceled
  total     Int         @default(0) // 进度分母：single=章节数，list=书籍数
  done      Int         @default(0) // 进度分子：与 total 同单位（保证 done ≤ total）
  chaptersDone  Int     @default(0) // 已采集章节数（list 模式的章节级副进度，跨书累计）
  chaptersTotal Int     @default(0) // 预计章节总数（list 模式，随书页解析逐步累加）
  created   Int         @default(0) // 新建书籍数
  updated   Int         @default(0) // 更新书籍数
  chapters  Int         @default(0) // 采集章节数
  message   String      @default("")
  log       String      @default("") // 追加式日志，\n 分隔，保留最近 100 行
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status])
}
